# Normalize text files in the repository to LF so checkouts are identical on
# Linux, macOS, Android, and Windows. Editors on Windows handle LF fine; only
# files that genuinely require CRLF should override this.
* text=auto eol=lf

# Windows command scripts need CRLF when executed by legacy cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
