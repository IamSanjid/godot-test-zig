.zig-cache/
zig-pkg/
zig-out/
src/godot/bindings/*
# Expose bindings through `godot.bindings` without hiding the module entry point.
!src/godot/bindings/bindings.zig
# Codegen output: dispatch glue, classes, builtins, and registries
src/godot/builtins/generated/*.zig
src/godot/classes/
src/godot/utility/
src/godot/constants.zig
src/godot/enums.zig
src/godot/native.zig
src/godot/singletons.zig
